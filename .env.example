# Proveedor de WhatsApp: 'meta' (Cloud API) o 'twilio' (sandbox gratis para pruebas)
WHATSAPP_PROVIDER=twilio

# WhatsApp Cloud API (solo si WHATSAPP_PROVIDER=meta)
WHATSAPP_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_ID=your_phone_id_here
WHATSAPP_VERIFY_TOKEN=your_verify_token_here

# Twilio (solo si WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Claude API
CLAUDE_API_KEY=your_claude_api_key_here

# Google
GOOGLE_SHEET_ID=your_sheet_id_here
GOOGLE_CREDENTIALS_PATH=./config/google-credentials.json
CALENDAR_ID=your_calendar_id_here

# Server
PORT=3000
NODE_ENV=development

# Demo mode (true = usa datos simulados, no llama a APIs externas)
DEMO_MODE=true

# Inmobiliaria config
AGENCY_NAME=Inmobiliaria Ejemplo
AGENCY_PHONE=+34 91 000 00 00
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=20
